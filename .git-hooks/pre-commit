#!/bin/sh
# Pre-commit hook: whitespace validation, then an advisory OpenCodeReview pass.
# Install with: git config core.hooksPath .git-hooks
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

echo "============================================="
echo "🚀 Running Pre-commit Hooks..."
echo "============================================="

# 1. Reject whitespace errors (AGENTS.md "Review before publishing" guidance)
echo "🔍 Checking for whitespace errors..."
if ! git diff --cached --check; then
  echo "❌ Whitespace errors found. Fix them or stage with --whitespace=fix." >&2
  exit 1
fi

echo "============================================="
echo "✅ Checks passed. Running AI review..."
echo "============================================="

# 2. Advisory AI review of staged changes (never blocks the commit)
if [ -x "$REPO_ROOT/hooks/pre-commit-open-code-review" ]; then
  "$REPO_ROOT/hooks/pre-commit-open-code-review" || true
else
  echo "[open-code-review] hooks/pre-commit-open-code-review not found — skipping."
fi

echo "============================================="
echo "✅ All pre-commit checks passed successfully!"
echo "============================================="
