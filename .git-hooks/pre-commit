#!/bin/sh
# Pre-commit hook: whitespace report, then an advisory OpenCodeReview pass.
# Install with: git config core.hooksPath .git-hooks
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

echo "============================================="
echo "🚀 Running Pre-commit Hooks..."
echo "============================================="

# 1. Report whitespace errors. Advisory only: this repository uses trailing
#    double-space as a Markdown hard line break (resume/llms-resume.txt), so a
#    hard failure here would block legitimate edits.
echo "🔍 Checking for whitespace errors..."
if ! git diff --cached --check; then
  echo "⚠️  Whitespace errors found (advisory — commit proceeds)." >&2
else
  echo "✅ No whitespace errors."
fi

echo "============================================="
echo "🤖 Running advisory AI review of local changes..."
echo "============================================="

# 2. Advisory AI review. It reviews the working tree (staged, unstaged, and
#    untracked files) and never blocks the commit.
if [ -x "$REPO_ROOT/hooks/pre-commit-open-code-review" ]; then
  "$REPO_ROOT/hooks/pre-commit-open-code-review" || true
else
  echo "[open-code-review] hooks/pre-commit-open-code-review not found — skipping." >&2
fi

echo "============================================="
echo "✅ Pre-commit checks finished. Commit proceeding."
echo "============================================="
